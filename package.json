{
    "name": "project-layout-tree",
    "displayName": "Project Layout Tree",
    "publisher": "zinken7",
    "description": "A vscode plugin that generates a tree directory in README.md.",
    "version": "0.0.1",
    "repository": "https://github.com/GGLuckjiu/project-tree",
    "keywords": [
        "layout-tree"
    ],
    "engines": {
        "vscode": "^1.55.0"
    },
    "categories": [
        "Other"
    ],
    "license": "MIT",
    "activationEvents": [
        "onCommand:extension.ProjectTree"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "extension.ProjectTree",
                "title": "Layout Tree"
            }
        ],
        "configuration": {
            "title": "Project Tree Configuration",
            "properties": {
                "ProjectTree.loadIgnore": {
                    "type": "boolean",
                    "default": true,
                    "description": "Read and ignore the configuration in the .gitignore"
                },
                "ProjectTree.theme": {
                    "type": "string",
                    "default": "perfect",
                    "enum": [
                        "normal",
                        "perfect"
                    ],
                    "enumDescriptions": [
                        "normal look",
                        "perfect look"
                    ],
                    "description": "Custom ascii tree's outlook"
                },
                "ProjectTree.withComment": {
                    "type": "boolean",
                    "default": false,
                    "description": "Always have a comment at the end of each line"
                },
                "ProjectTree.commentDistance": {
                    "type": "number",
                    "default": 5,
                    "description": "The distance between the comment and the longest title, the minimum is 1"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "webpack",
        "watch": "webpack --watch",
        "package": "webpack --mode production --devtool hidden-source-map",
        "test-compile": "tsc -p ./",
        "test-watch": "tsc -watch -p ./",
        "pretest": "npm run test-compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "dependencies": {},
    "devDependencies": {
        "@types/glob": "^7.1.3",
        "@types/mocha": "^8.0.4",
        "@types/node": "^12.11.7",
        "@types/vscode": "^1.55.0",
        "@typescript-eslint/eslint-plugin": "^4.14.1",
        "@typescript-eslint/parser": "^4.14.1",
        "eslint": "^7.19.0",
        "glob": "^7.1.6",
        "mocha": "^8.2.1",
        "ts-loader": "^8.0.14",
        "tslint": "^5.20.1",
        "typescript": "^4.1.3",
        "vscode-test": "^1.5.0",
        "webpack": "^5.19.0",
        "webpack-cli": "^4.4.0"
    }
}
